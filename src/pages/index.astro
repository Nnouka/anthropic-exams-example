---
import { exams } from '../data/exams.ts';

// Build marker: scripts/status.sh looks for this to confirm the new build is live.
const build = (process.env.GITHUB_SHA ?? 'local').slice(0, 7);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>Claude Developer Exam Topics</title>
    <meta name="description" content="Topics on the Claude Certified Developer Foundations and Professional exams." />
  </head>
  <body>
    <a class="skip" href="#main">Skip to exam topics</a>

    <header>
      <h1>Claude Developer Exam Topics</h1>
      <p class="lede">
        Only the topics: each exam's domains, their weights, and the skills measured.
      </p>
      <nav aria-label="Exams">
        <ul class="tabs" role="list">
          {exams.map((e) => (
            <li><a href={`#${e.id}`}>{e.short} ({e.code})</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main" tabindex="-1">
      {exams.map((exam) => (
        <section id={exam.id} aria-labelledby={`${exam.id}-h`}>
          <div class="exam-head">
            <h2 id={`${exam.id}-h`}>{exam.title}</h2>
            <a class="guide" href={exam.guideUrl} target="_blank" rel="noopener noreferrer">
              Official exam guide (PDF)<span class="vh"> for {exam.title}, opens in a new tab</span>
              <span aria-hidden="true">&nbsp;↗</span>
            </a>
          </div>
          <p class="meta">{exam.code} · {exam.effective}</p>
          <ol class="domains" role="list">
            {exam.domains.map((d) => (
              <li>
                <div class="domain-head">
                  <h3>{d.name}</h3>
                  <span class="weight"><span class="vh">Exam weight: </span>{d.weight}%</span>
                </div>
                <div class="bar" aria-hidden="true"><span style={`width:${d.weight * 5}%`}></span></div>
                <ul role="list">
                  {d.skills.map((s) => <li>{s}</li>)}
                </ul>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </main>

    <footer>
      <small>Build <code data-build>{build}</code></small>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfaf8;
    --fg: #1f1d1a;
    --muted: #6b665e;
    --card: #ffffff;
    --line: #e4e0d8; /* decorative dividers only */
    --edge: #8c867c; /* component borders, 3:1 or better */
    --accent: #b0502f; /* 5:1 on --bg and --card */
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1a1816;
      --fg: #f1eee8;
      --muted: #a39d92;
      --card: #24211e;
      --line: #38342f;
      --edge: #77716a;
      --accent: #e08a68;
    }
  }
  * { box-sizing: border-box; }
  html { scroll-padding-top: 1rem; }
  body {
    margin: 0 auto;
    max-width: 48rem;
    padding: 2rem 1rem 3rem;
    background: var(--bg);
    color: var(--fg);
    font: 1rem/1.5 system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
  h1 { font-size: 1.9rem; margin: 0 0 0.25rem; line-height: 1.2; }
  h2 { font-size: 1.3rem; margin: 0; line-height: 1.3; }
  h3 { font-size: 1rem; margin: 0; overflow-wrap: anywhere; }
  .lede, .meta { color: var(--muted); margin: 0.25rem 0 0; }

  /* Visible keyboard focus everywhere (2.4.7), high contrast in both themes. */
  :focus-visible {
    outline: 3px solid var(--fg);
    outline-offset: 3px;
    border-radius: 4px;
  }
  main:focus { outline: none; } /* skip-link target, not interactive */

  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 10;
    padding: 0.625rem 1rem;
    background: var(--fg);
    color: var(--bg);
    border-radius: 6px;
  }
  .skip:focus { top: 0.75rem; }

  .tabs { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; padding: 0; margin: 1rem 0 0; }
  .tabs a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem; /* 44px touch target */
    padding: 0 1rem;
    border: 1px solid var(--edge);
    border-radius: 999px;
    color: var(--fg);
    text-decoration: none;
  }
  .tabs a:hover { border-color: var(--accent); color: var(--accent); }

  .exam-head { display: flex; flex-wrap: wrap; align-items: center; gap: 0 1rem; margin-top: 2.5rem; }
  .guide {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.9rem;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .guide:hover { text-decoration-thickness: 2px; }

  .domains { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 0.75rem; }
  .domains > li {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.875rem 1rem;
  }
  .domain-head { display: flex; justify-content: space-between; gap: 0.75rem; align-items: baseline; }
  .weight { color: var(--accent); font-weight: 600; font-variant-numeric: tabular-nums; }
  .bar { height: 4px; background: var(--line); border-radius: 2px; margin: 0.5rem 0 0.625rem; }
  .bar span { display: block; height: 100%; background: var(--accent); border-radius: 2px; }
  .domains ul { margin: 0; padding-left: 1.25rem; color: var(--muted); }
  footer { margin-top: 2.5rem; color: var(--muted); }

  @media (forced-colors: active) {
    .bar span { background: Highlight; }
    .tabs a { border-color: ButtonText; }
  }
</style>
